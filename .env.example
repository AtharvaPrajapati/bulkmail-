# Base URL of the backend API.
#
# In development point this at the local backend (default port 3000).
# In production you can either:
#   - leave it unset and let the backend serve the built frontend (single
#     artifact - the frontend will use "/api" on the same origin), or
#   - set it to the absolute URL of a separately deployed API,
#     e.g. https://api.example.com/api
VITE_API_BASE_URL=http://localhost:3000/api
